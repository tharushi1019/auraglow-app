# AuraGlow Backend Environment Configuration Example
# Copy this file to ".env" and fill in your real values. Never commit ".env" to GitHub.

PORT=5000
NODE_ENV=development

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret: run -> node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# ── ImgBB ─────────────────────────────────────────────────────────────────────
IMGBB_API_KEY=your-imgbb-api-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

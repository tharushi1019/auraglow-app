# AuraGlow Frontend Environment Configuration Example
# Copy this file to ".env" and fill in your real values. Never commit ".env" to GitHub.

# ── Supabase (Public Anon Key) ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# ── ImgBB API Key ─────────────────────────────────────────────────────────────
VITE_IMGBB_API_KEY=your-imgbb-api-key-here

# ── Backend API URL ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
